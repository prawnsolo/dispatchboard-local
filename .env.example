# Optional Google Maps key for Local (Geocoding + Routes).
# Copy to `.env.local` (gitignored) for Vite / `npm run dev`.
# Desktop Settings → paste key still wins when a key file exists on this PC.
# Never commit a real key. Do not log this value.
# Enable on the key: Geocoding API; Routes API only if you use Check drive times.
# Basemap stays MapLibre + OpenFreeMap (not Maps JavaScript).
VITE_GOOGLE_MAPS_API_KEY=

# Manual New job / New job here / Schedule here create. Default off.
# VITE_ENABLE_JOB_CREATE=false

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DispatchBoard (Local)",
  "version": "0.3.0",
  "identifier": "com.tigerfuel.dispatchboard.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DispatchBoard (Local)",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost blob: data: https://tiles.openfreemap.org",
        "font-src": "'self' data: https://tiles.openfreemap.org",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https://tiles.openfreemap.org https://routes.googleapis.com",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "media-src": "'self' blob: data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Dispatch board that keeps jobs on this PC",
    "longDescription": "Single-user DispatchBoard. Jobs and sites stay in a SQLite file on this computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:dispatchboard.db"
      ]
    }
  }
}
